vibedocs/

# ---------- Generated newspaper output ----------
issues/*
!issues/.gitkeep

# ---------- Legacy single-paper + stray CLI / build artifacts ----------
# The root-level single-paper (index.html + app.js + build_puzzles.py +
# style.css) is the original standalone newspaper that predates the web
# app. The web app generates fresh per-issue output under
# issues/{slug}/, and ships its own canonical style.css at
# backend/app/templates/style.css. The legacy files are kept locally
# for the original CLI workflow but not shipped publicly.
/index.html
/app.js
/build_puzzles.py
/style.css
_games_fragment.html

